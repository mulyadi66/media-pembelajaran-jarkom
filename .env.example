# Supabase (rekap nilai per siswa). Isi jika ingin sync nilai ke database.
# Cara buat: supabase.com -> New project (gratis) -> Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PIN halaman Rekap Nilai (khusus guru), maksimal 6 digit
VITE_REKAP_PIN=2468

# Token untuk membuka soal Ujian (Post Test modul). Guru membagikan token ini ke siswa.
#
# JANGAN perlu diisi untuk rotasi rutin. Token + masa berlaku disimpan di tabel
# `exam_tokens` Supabase dan bisa diubah dari halaman Rekap Nilai TANPA deploy.
# Env var di bawah hanya jadi cadangan kalau Supabase kosong atau sedang down.
#
# Masa berlaku diisi sebagai tanggal (ISO), contoh: 2026-10-31T23:59
# Kalau kosong = tidak kedaluwarsa.
VITE_EXAM_TOKEN_MPK1=TKJ235
VITE_EXAM_TOKEN_MPK1_EXPIRES=

VITE_EXAM_TOKEN_KKA=KKA235
VITE_EXAM_TOKEN_KKA_EXPIRES=

VITE_EXAM_TOKEN_KKA_XI=KXI235
VITE_EXAM_TOKEN_KKA_XI_EXPIRES=

# Variabel lama (semua mapel jadi satu token). Masih dibaca sebagai cadangan
# untuk MPK 1 supaya instalasi yang belum migrasi tidak kehilangan token.
VITE_EXAM_TOKEN=